# Ashutosh Kumar — AI Job Search & Application Agent
# Environment Configuration

# Operational Mode
# DRY_RUN: When true, no applications will ever be submitted. All workflows simulate matching and document creation.
DRY_RUN=true

# Submission Safety Gate: Must be explicitly set to 'true' AND DRY_RUN must be 'false' before any live submission is performed.
ENABLE_AUTOSUBMIT=false

# Scoring & Filter Configuration
MIN_MATCH_SCORE=75
REVIEW_MATCH_SCORE=60
MAX_JOB_AGE_DAYS=30
MIN_SALARY_LPA=10.0

# Storage Paths
TRACKER_PATH=data/applications.csv
REPORTS_PATH=data/reports
OUTPUT_DOCS_PATH=data/tailored-documents

# External Job Board Connectors (LinkedIn, Naukri, Indeed)
# Optional API Keys / Access Tokens:
# If left blank, the agent utilizes candidate-guided search queries and verified enterprise feeds.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
NAUKRI_API_KEY=
INDEED_API_KEY=
RAPIDAPI_KEY=

# Public Job Aggregator Feeds
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
